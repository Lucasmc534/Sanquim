# Local MySQL (change these values before using outside your own machine)
MYSQL_DATABASE=sanquim
MYSQL_USER=sanquim_app
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
DB_URL=jdbc:mysql://localhost:3307/sanquim?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=sanquim_app
DB_PASSWORD=change-me-local

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=replace-with-a-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=30

# Optional, first-install bootstrap only; remove after the first account is created.
BOOTSTRAP_SECRETARIA_EMAIL=
BOOTSTRAP_SECRETARIA_NAME=
BOOTSTRAP_SECRETARIA_PASSWORD=

# Optional demo accounts; enable only with synthetic data in a controlled environment.
SANQUIM_DEMO_ACCOUNTS_ENABLED=false
SANQUIM_DEMO_ALUNO_EMAIL=
SANQUIM_DEMO_ALUNO_NAME=
SANQUIM_DEMO_ALUNO_PASSWORD=
SANQUIM_DEMO_PROFESSOR_EMAIL=
SANQUIM_DEMO_PROFESSOR_NAME=
SANQUIM_DEMO_PROFESSOR_PASSWORD=
SANQUIM_DEMO_SECRETARIA_EMAIL=
SANQUIM_DEMO_SECRETARIA_NAME=
SANQUIM_DEMO_SECRETARIA_PASSWORD=
